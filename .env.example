# Copy to .env for local development. Do not commit real secrets.
POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-secret-manager-value
DATABASE_URL=postgresql+psycopg://replace-user:replace-password@replace-host:5432/replace-database
# Neon: use the -pooler host above for requests, direct host here for Alembic.
DATABASE_DIRECT_URL=postgresql+psycopg://replace-user:replace-password@replace-direct-host:5432/replace-database?sslmode=require
REDIS_URL=redis://replace-host:6379/0
APP_ENVIRONMENT=development
AUTH_PROVIDER=clerk
CLERK_ISSUER=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless Clerk verification (never a private key).
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
PRIVATE_RESUME_STORAGE_PATH=/var/lib/internagent/resumes
ALLOWED_ORIGINS=["http://localhost:3000"]
REQUIRE_HTTPS=true
RATE_LIMIT_PER_MINUTE=120
SECRET_MANAGER_PROVIDER=replace-with-managed-secret-provider
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
INTERNAGENT_API_URL=http://api:8000/api/v1
