# Copy to .env for local development. Do not commit real secrets.
POSTGRES_DB=internagent
POSTGRES_USER=internagent
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://internagent:local-development-only@db:5432/internagent
REDIS_URL=redis://redis:6379/0
APP_ENVIRONMENT=development
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
PRIVATE_RESUME_STORAGE_PATH=/var/lib/internagent/resumes
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
